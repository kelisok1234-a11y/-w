<Item class="StarterPlayer" referent="RBX10"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX9"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX8"><Properties><string name="Name">RNGdleClient</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[local __ok, __err = pcall(function()
-- RNGdle 2D v2 | LocalScript (StarterPlayerScripts)
-- Вся игра нарисована через ScreenGui => это чистая 2D игра.
-- v2: больше монет (бонусы, семёрки, шахта, слот, подарки, золотые монеты),
--     сейф для лучших чисел, достижения и ЖЁСТКИЕ спецэффекты.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
		end)
		if ok then break end
		task.wait(0.5)
	end
end)

----------------------------------------------------------------
-- РЕДКОСТИ
----------------------------------------------------------------
local TIERS = {
	{ id = "common",    name = "ОБЫЧНОЕ",     color = Color3.fromRGB(165, 172, 186), coins = 2,      odds = 1,      desc = "Любое число без особенностей." },
	{ id = "uncommon",  name = "НЕОБЫЧНОЕ",   color = Color3.fromRGB(90, 215, 115),  coins = 10,     odds = 10,     desc = "Три одинаковые цифры в числе, остальные разные (например 414843)." },
	{ id = "rare",      name = "РЕДКОЕ",      color = Color3.fromRGB(65, 155, 255),  coins = 50,     odds = 15,     desc = "4 одинаковые цифры, три пары (112233), фулл-хаус (111223), 4 цифры подряд (3456)." },
	{ id = "epic",      name = "ЭПИЧЕСКОЕ",   color = Color3.fromRGB(185, 95, 255),  coins = 300,    odds = 585,    desc = "Палиндром (123321), две тройки (111222), круглое число (500000), три семёрки подряд (777)." },
	{ id = "legendary", name = "ЛЕГЕНДАРНОЕ", color = Color3.fromRGB(255, 175, 30),  coins = 2000,   odds = 925,    desc = "Повтор: 676767, 123123. Мемы: 696969, 420420, 314159, 007007, 112358. Четыре семёрки." },
	{ id = "mythic",    name = "МИФИЧЕСКОЕ",  color = Color3.fromRGB(255, 70, 110),  coins = 20000,  odds = 1818,   desc = "5 одинаковых цифр (111112) или идеальная лесенка 123456 / 987654." },
	{ id = "secret",    name = "СЕКРЕТНОЕ",   color = Color3.fromRGB(255, 255, 255), coins = 250000, odds = 100000, desc = "Все 6 цифр одинаковые: 000000, 111111 ... 999999." },
}

-- мемные числа: { редкость, подпись }
local MEMES = {
	["676767"] = { 5, "67 67 67 — легенда!" },
	["696969"] = { 5, "Ну ты понял :)" },
	["420420"] = { 5, "Мемное число" },
	["314159"] = { 5, "Число Пи" },
	["271828"] = { 5, "Число e" },
	["161803"] = { 5, "Золотое сечение" },
	["112358"] = { 5, "Числа Фибоначчи" },
	["007007"] = { 5, "Агент 007" },
	["100500"] = { 5, "Сто пятьсот" },
	["800555"] = { 5, "8-800-555..." },
	["777000"] = { 5, "Семёрки и нули" },
	["000777"] = { 5, "Нули и семёрки" },
}

local function isRun(d, a, len, dir)
	for i = a, a + len - 2 do
		if d[i + 1] - d[i] ~= dir then return false end
	end
	return true
end

local function hasRun(d, len)
	for a = 1, 6 - len + 1 do
		if isRun(d, a, len, 1) or isRun(d, a, len, -1) then return true end
	end
	return false
end

local function has(s, sub)
	return string.find(s, sub, 1, true) ~= nil
end

-- возвращает номер редкости (1..7) и причину
local function classify(s)
	local d, counts = {}, {}
	for i = 1, 6 do
		d[i] = tonumber(s:sub(i, i))
		counts[d[i]] = (counts[d[i]] or 0) + 1
	end
	local g = {}
	for _, c in pairs(counts) do g[#g + 1] = c end
	table.sort(g, function(a, b) return a > b end)
	local g1, g2, g3 = g[1], g[2] or 0, g[3] or 0
	local c7 = counts[7] or 0

	if g1 == 6 then return 7, "Все 6 цифр одинаковые!" end
	if MEMES[s] then return MEMES[s][1], MEMES[s][2] end
	if isRun(d, 1, 6, 1) or isRun(d, 1, 6, -1) then return 6, "Идеальная лесенка" end
	if g1 == 5 then return 6, "5 одинаковых цифр" end
	if has(s, "7777") then return 5, "Четыре семёрки подряд!" end
	if c7 >= 4 then return 5, "Четыре семёрки!" end
	if s:sub(1, 3) == s:sub(4, 6) then return 5, "Повтор тройки (ABCABC)" end
	if s:sub(1, 2) == s:sub(3, 4) and s:sub(3, 4) == s:sub(5, 6) then return 5, "Повтор пары (ABABAB)" end
	if s == s:reverse() then return 4, "Палиндром" end
	if g1 == 3 and g2 == 3 then return 4, "Две тройки (AAABBB)" end
	if s:sub(2) == "00000" then return 4, "Круглое число" end
	if has(s, "777") then return 4, "Счастливая тройка 777" end
	if g1 == 4 then return 3, "4 одинаковые цифры" end
	if g1 == 2 and g2 == 2 and g3 == 2 then return 3, "Три пары" end
	if g1 == 3 and g2 == 2 then return 3, "Фулл-хаус" end
	if hasRun(d, 4) then return 3, "4 цифры подряд" end
	if g1 == 3 then return 2, "Три одинаковые цифры" end
	return 1, "Обычное число"
end

----------------------------------------------------------------
-- БОНУСЫ (дополнительные монеты к награде за редкость)
----------------------------------------------------------------
local function allDigits(c, f)
	for i = 1, 6 do
		if not f(c.d[i]) then return false end
	end
	return true
end

local function isEven(x) return x % 2 == 0 end
local function isOdd(x) return x % 2 == 1 end
local function isPrimeDigit(x) return x == 2 or x == 3 or x == 5 or x == 7 end
local function isBin(x) return x == 0 or x == 1 end

local function monotone(d, dir)
	for i = 1, 5 do
		if (d[i + 1] - d[i]) * dir < 0 then return false end
	end
	return true
end

local BONUSES = {
	{ id = "lucky7",   name = "Счастливая семёрка", desc = "В числе есть хотя бы одна цифра 7",              coins = 7,     test = function(c) return c.c7 >= 1 end },
	{ id = "seven2",   name = "Две семёрки",        desc = "Ровно две цифры 7",                              coins = 77,    test = function(c) return c.c7 == 2 end },
	{ id = "seven3",   name = "Тройная семёрка",    desc = "Ровно три цифры 7",                              coins = 777,   test = function(c) return c.c7 == 3 end },
	{ id = "seven777", name = "ДЖЕКПОТ 777",        desc = "Три семёрки подряд (777)",                       coins = 1777,  test = function(c) return has(c.s, "777") end },
	{ id = "seven4",   name = "Семёрочный шторм",   desc = "Четыре и больше семёрок",                        coins = 7777,  test = function(c) return c.c7 >= 4 end },
	{ id = "edge7",    name = "Семёрки по краям",   desc = "Число начинается и заканчивается на 7",          coins = 77,    test = function(c) return c.d[1] == 7 and c.d[6] == 7 end },
	{ id = "ticket",   name = "Счастливый билет",   desc = "Сумма первых трёх цифр = сумме последних трёх",  coins = 100,   test = function(c) return c.d[1] + c.d[2] + c.d[3] == c.d[4] + c.d[5] + c.d[6] end },
	{ id = "even",     name = "Чётное царство",     desc = "Все цифры чётные",                               coins = 50,    test = function(c) return allDigits(c, isEven) end },
	{ id = "odd",      name = "Нечётное царство",   desc = "Все цифры нечётные",                             coins = 50,    test = function(c) return allDigits(c, isOdd) end },
	{ id = "prime",    name = "Простые цифры",      desc = "Только цифры 2, 3, 5 и 7",                       coins = 60,    test = function(c) return allDigits(c, isPrimeDigit) end },
	{ id = "binary",   name = "Двоичный код",       desc = "Только цифры 0 и 1",                             coins = 300,   test = function(c) return allDigits(c, isBin) end },
	{ id = "duo",      name = "Дуэт",               desc = "Всего две разные цифры в числе",                 coins = 150,   test = function(c) return c.distinct == 2 end },
	{ id = "up",       name = "Лесенка вверх",      desc = "Цифры не убывают слева направо (112357)",        coins = 400,   test = function(c) return monotone(c.d, 1) end },
	{ id = "down",     name = "Лесенка вниз",       desc = "Цифры не возрастают слева направо (997431)",     coins = 400,   test = function(c) return monotone(c.d, -1) end },
	{ id = "zeros",    name = "Нулевой герой",      desc = "Три и больше нулей",                             coins = 25,    test = function(c) return (c.cnt[0] or 0) >= 3 end },
	{ id = "unlucky",  name = "Чёртова дюжина",     desc = "В числе есть 13",                                coins = 13,    test = function(c) return has(c.s, "13") end },
	{ id = "beast",    name = "Число зверя",        desc = "В числе есть 666",                               coins = 666,   test = function(c) return has(c.s, "666") end },
	{ id = "eights",   name = "Восьмёрки богатства", desc = "В числе есть 888",                              coins = 888,   test = function(c) return has(c.s, "888") end },
	{ id = "e404",     name = "Ошибка 404",         desc = "В числе есть 404",                               coins = 404,   test = function(c) return has(c.s, "404") end },
	{ id = "leet",     name = "Элита 1337",         desc = "В числе есть 1337",                              coins = 1337,  test = function(c) return has(c.s, "1337") end },
	{ id = "date",     name = "Дата",               desc = "Число похоже на дату ДДММГГ",                    coins = 30,    test = function(c)
		local dd, mm = tonumber(c.s:sub(1, 2)), tonumber(c.s:sub(3, 4))
		return dd >= 1 and dd <= 31 and mm >= 1 and mm <= 12
	end },
	{ id = "time",     name = "Время",              desc = "Число похоже на время ЧЧММСС",                   coins = 20,    test = function(c)
		local hh, mi, ss = tonumber(c.s:sub(1, 2)), tonumber(c.s:sub(3, 4)), tonumber(c.s:sub(5, 6))
		return hh <= 23 and mi <= 59 and ss <= 59
	end },
	{ id = "ny",       name = "Новый год",          desc = "Число начинается с 0101",                        coins = 10101, test = function(c) return c.s:sub(1, 4) == "0101" end },
	{ id = "pi",       name = "Число Пи",           desc = "Число начинается с 3141",                        coins = 3141,  test = function(c) return c.s:sub(1, 4) == "3141" end },
	{ id = "hundred",  name = "Сотка",              desc = "В числе есть 100",                               coins = 100,   test = function(c) return has(c.s, "100") end },
	{ id = "distinct", name = "Все разные",         desc = "Все 6 цифр разные",                              coins = 40,    test = function(c) return c.distinct == 6 end },
	{ id = "sum7",     name = "Сумма семь",         desc = "Сумма цифр равна 7",                             coins = 777,   test = function(c) return c.sum == 7 end },
	{ id = "sum21",    name = "Очко!",              desc = "Сумма цифр равна 21",                            coins = 21,    test = function(c) return c.sum == 21 end },
	{ id = "sum42",    name = "Ответ на всё",       desc = "Сумма цифр равна 42",                            coins = 420,   test = function(c) return c.sum == 42 end },
}

local function findBonuses(s)
	local c = { s = s, d = {}, cnt = {}, sum = 0, distinct = 0 }
	for i = 1, 6 do
		local v = tonumber(s:sub(i, i))
		c.d[i] = v
		c.sum = c.sum + v
		if not c.cnt[v] then c.distinct = c.distinct + 1 end
		c.cnt[v] = (c.cnt[v] or 0) + 1
	end
	c.c7 = c.cnt[7] or 0
	local res = {}
	for _, b in ipairs(BONUSES) do
		if b.test(c) then res[#res + 1] = b end
	end
	return res
end

----------------------------------------------------------------
-- ДАННЫЕ
----------------------------------------------------------------
local function newData()
	return {
		coins = 0, rolls = 0, luck = 0, speed = 0, auto = false,
		mult = 0, magnet = 0, miner = 0, safeCap = 0,
		found = {}, best = { n = "------", t = 0 }, history = {},
		safe = {}, safeT = 0, safeStash = 0, safed = 0,
		bonus = {}, ach = {}, earned = 0,
		lastDaily = 0, dailyStreak = 0, dailyClaims = 0,
		lastSlot = 0, slotSpins = 0, slotJackpots = 0,
		golden = 0, shopBuys = 0,
	}
end

local data = newData()
local saveRemote = ReplicatedStorage:FindFirstChild("SaveData")
local dirty = false
local hooks = {}

-- Загрузка сохранения В ОТДЕЛЬНОМ ПОТОКЕ: если сервер не ответит,
-- интерфейс всё равно построится и игра будет работать.
task.spawn(function()
	local loadRemote = ReplicatedStorage:WaitForChild("LoadData", 15)
	if not (loadRemote and loadRemote:IsA("RemoteFunction")) then return end
	local ok, res = pcall(function() return loadRemote:InvokeServer() end)
	if ok and type(res) == "table" then
		for k, v in pairs(newData()) do
			if res[k] == nil then res[k] = v end
		end
		data = res
		if hooks.hud then pcall(hooks.hud) end
		if hooks.auto then pcall(hooks.auto) end
	end
end)

task.spawn(function()
	while true do
		task.wait(3)
		if not saveRemote then saveRemote = ReplicatedStorage:FindFirstChild("SaveData") end
		if dirty and saveRemote then
			dirty = false
			saveRemote:FireServer(data)
		end
	end
end)

local function fmt(n)
	local s = string.format("%.0f", math.floor(n))
	local r = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (r:gsub("^ ", ""))
end

local function fmtTime(sec)
	sec = math.max(0, math.floor(sec))
	local h = math.floor(sec / 3600)
	local m = math.floor((sec % 3600) / 60)
	local s = sec % 60
	if h > 0 then return string.format("%d:%02d:%02d", h, m, s) end
	return string.format("%d:%02d", m, s)
end

----------------------------------------------------------------
-- UI ХЕЛПЕРЫ
----------------------------------------------------------------
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 215, 90)
local DIM = Color3.fromRGB(155, 155, 160)
local BOX_STROKE = Color3.fromRGB(58, 58, 64)

local function make(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do inst[k] = v end
	inst.Parent = parent
	return inst
end

local function corner(parent, r)
	return make("UICorner", { CornerRadius = UDim.new(r, 0) }, parent)
end

local function stroke(parent, color, thick)
	return make("UIStroke", { Color = color, Thickness = thick or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, parent)
end

local function label(parent, props, maxText)
	local l = make("TextLabel", {
		BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextColor3 = WHITE,
		TextScaled = true, BorderSizePixel = 0,
	}, parent)
	for k, v in pairs(props) do l[k] = v end
	if maxText then make("UITextSizeConstraint", { MaxTextSize = maxText }, l) end
	return l
end

local function button(parent, text, color, props)
	local b = make("TextButton", {
		Text = text, Font = Enum.Font.GothamBlack, TextColor3 = WHITE, BackgroundColor3 = color,
		AutoButtonColor = true, TextScaled = true, BorderSizePixel = 0,
	}, parent)
	for k, v in pairs(props or {}) do b[k] = v end
	corner(b, 0.22)
	-- мягкий глянцевый градиент + тёмная рамка
	make("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(175, 175, 175)), Rotation = 90,
	}, b)
	make("UIStroke", {
		Color = Color3.new(0, 0, 0), Thickness = 2, Transparency = 0.35,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, b)
	make("UITextSizeConstraint", { MaxTextSize = 34 }, b)
	make("UIPadding", {
		PaddingTop = UDim.new(0.2, 0), PaddingBottom = UDim.new(0.2, 0),
		PaddingLeft = UDim.new(0.06, 0), PaddingRight = UDim.new(0.06, 0),
	}, b)
	local sc = make("UIScale", {}, b)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(sc, TweenInfo.new(0.08), { Scale = 0.94 }):Play()
	end)
	local function up()
		TweenService:Create(sc, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	b.MouseButton1Up:Connect(up)
	b.MouseLeave:Connect(up)
	return b
end

local function clearList(list)
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
end

local function row(list, height, order)
	local r = make("Frame", {
		Size = UDim2.new(1, -10, 0, height), BackgroundColor3 = Color3.fromRGB(25, 25, 28),
		BorderSizePixel = 0, LayoutOrder = order,
	}, list)
	corner(r, 0.12)
	return r
end

local function simpleText(parent, text, pos, size, textSize, color, font, xalign)
	return make("TextLabel", {
		BackgroundTransparency = 1, Text = text, Position = pos, Size = size, TextSize = textSize,
		TextColor3 = color or WHITE, Font = font or Enum.Font.GothamBold, TextWrapped = true,
		TextXAlignment = xalign or Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
	}, parent)
end

----------------------------------------------------------------
-- ГЛАВНЫЙ ЭКРАН
----------------------------------------------------------------
local UI = {}

local old = playerGui:FindFirstChild("RNGdle")
if old then old:Destroy() end

local gui = make("ScreenGui", {
	Name = "RNGdle", ResetOnSpawn = false, IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 10,
}, playerGui)

-- фон (не трясётся)
local bg = make("Frame", {
	Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0,
	ClipsDescendants = true, ZIndex = 1,
