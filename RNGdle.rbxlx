local G = { rolling = false, autoOn = false, streak = 0, last = nil, slotBusy = false }
local updateHud, checkAch

-- уведомления сверху
local toastHolder = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.015), Size = UDim2.fromScale(0.8, 0.4),
	BackgroundTransparency = 1, ZIndex = 60,
}, gui)
make("UISizeConstraint", { MaxSize = Vector2.new(560, 10000) }, toastHolder)
make("UIListLayout", {
	Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center,
	SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Top,
}, toastHolder)
local toastN = 0

local function toast(text, color)
	toastN = toastN + 1
	local f = make("Frame", {
		Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = Color3.fromRGB(15, 15, 17),
		BorderSizePixel = 0, LayoutOrder = toastN, ZIndex = 60,
	}, toastHolder)
	corner(f, 0.25)
	local st = stroke(f, color or WHITE, 2)
	local l = label(f, {
		Text = text, TextColor3 = color or WHITE, Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4), ZIndex = 61,
	}, 20)
	task.delay(3.2, function()
		TweenService:Create(f, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(st, TweenInfo.new(0.5), { Transparency = 1 }):Play()
		TweenService:Create(l, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		task.delay(0.55, function() f:Destroy() end)
	end)
end

----------------------------------------------------------------
-- формулы
----------------------------------------------------------------
local function coinMult() return 1 + 0.5 * data.mult end
local function comboMult() return 1 + 0.05 * math.min(G.streak, 20) end
local function minerRate() return 3 * data.miner * data.miner end
local function safeCapacity() return 6 + 2 * data.safeCap end

local function addCoins(n)
	data.coins = data.coins + n
	data.earned = data.earned + n
	dirty = true
end

----------------------------------------------------------------
-- СЕЙФ: хранит лучшие числа и приносит пассивный доход
----------------------------------------------------------------
local SAFE_SECS_CAP = 8 * 3600

local function safeRate() -- монет в секунду
	local r = 0
	for _, e in ipairs(data.safe) do
		local tier = TIERS[e.t] or TIERS[1]
		r = r + math.max(1, math.floor(tier.coins * 0.02)) / 30
	end
	return r
end

local function safePending()
	local live = 0
	if data.safeT > 0 and #data.safe > 0 then
		live = safeRate() * math.min(os.time() - data.safeT, SAFE_SECS_CAP)
	end
	return math.floor(data.safeStash + live)
end

local function settleSafe()
	data.safeStash = safePending()
	data.safeT = os.time()
end

local function inSafe(n)
	for _, s in ipairs(data.safe) do
		if s.n == n then return true end
	end
	return false
end

local function sortSafe()
	table.sort(data.safe, function(a, b)
		if a.t ~= b.t then return a.t > b.t end
		return a.n < b.n
	end)
end

local function addToSafe(e)
	if inSafe(e.n) then return false, "Это число уже в сейфе" end
	if #data.safe >= safeCapacity() then return false, "Сейф полон! Расширь его в магазине или освободи слот" end
	settleSafe()
	data.safe[#data.safe + 1] = { n = e.n, t = e.t, why = e.why or "" }
	sortSafe()
	data.safed = data.safed + 1
	dirty = true
	return true, "Число " .. e.n .. " спрятано в сейф!"
end

local function claimSafe()
	local p = safePending()
	if p <= 0 then return 0 end
	addCoins(p)
	data.safeStash = 0
	data.safeT = os.time()
	return p
end

----------------------------------------------------------------
-- ДОСТИЖЕНИЯ (авто-награда монетами)
----------------------------------------------------------------
local function foundAtLeast(minTier)
	local n = 0
	for i = minTier, 7 do n = n + (data.found[TIERS[i].id] or 0) end
	return n
end

local function bonusKinds()
	local n = 0
	for _ in pairs(data.bonus) do n = n + 1 end
	return n
end

