----------------------------------------------------------------
-- ПАНЕЛИ
----------------------------------------------------------------
local anyPanelOpen = false
local panels = {}

local function makePanel(title)
	local overlay = make("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.2,
		Text = "", AutoButtonColor = false, Visible = false, ZIndex = 20, BorderSizePixel = 0,
	}, gui)
	local frame = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.88, 0.86), BackgroundColor3 = Color3.fromRGB(15, 15, 17),
		BorderSizePixel = 0, Active = true,
	}, overlay)
	corner(frame, 0.03)
	stroke(frame, Color3.fromRGB(72, 72, 80), 3)
	make("UISizeConstraint", { MaxSize = Vector2.new(780, 600) }, frame)

	label(frame, {
		Text = title, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromScale(0.04, 0.02), Size = UDim2.fromScale(0.7, 0.09),
	}, 34)

	local close = button(frame, "X", Color3.fromRGB(220, 60, 70), {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(44, 44),
	})

	local list = make("ScrollingFrame", {
		Position = UDim2.fromScale(0.03, 0.13), Size = UDim2.fromScale(0.94, 0.85),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y,
	}, frame)
	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)

	local panel = { overlay = overlay, list = list, frame = frame, isOpen = false }
	function panel.open()
		if panel.refresh then panel.refresh() end
		overlay.Visible = true
		panel.isOpen = true
		anyPanelOpen = true
	end
	function panel.close()
		overlay.Visible = false
		panel.isOpen = false
		anyPanelOpen = false
		for _, p in ipairs(panels) do
			if p.isOpen then anyPanelOpen = true end
		end
	end
	close.MouseButton1Click:Connect(panel.close)
	-- рамка Active=true "съедает" клики внутри окна, поэтому сюда доходят только клики снаружи
	overlay.MouseButton1Click:Connect(panel.close)
	panels[#panels + 1] = panel
	return panel
end

