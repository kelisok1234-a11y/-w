checkAch = function()
	for _, a in ipairs(ACH) do
		if not data.ach[a.id] and a.get() >= a.goal then
			data.ach[a.id] = true
			addCoins(a.reward)
			toast("НАГРАДА: " .. a.name .. "   +" .. fmt(a.reward), GOLD)
			local cx = gui.AbsoluteSize.X / 2
			FX.burst(cx, 90, 18, { GOLD }, 150, 400, "coin")
			FX.sound("coin", 1)
		end
	end
end

----------------------------------------------------------------
-- HUD
----------------------------------------------------------------
updateHud = function()
	UI.coinsLabel.Text = "МОНЕТЫ: " .. fmt(data.coins)
	local best = data.best
	local bestTxt = "—"
	if best.t > 0 then
		bestTxt = best.n .. " (" .. TIERS[best.t].name .. ")"
	end
	UI.statsLabel.Text = "Круток: " .. fmt(data.rolls) .. "   |   Лучшее: " .. bestTxt
		.. "   |   Удача: +" .. data.luck .. "   |   Сейф: " .. #data.safe .. "/" .. safeCapacity()
	local parts = {}
	if minerRate() > 0 then parts[#parts + 1] = "Шахта +" .. fmt(minerRate()) .. "/сек" end
	if #data.safe > 0 then parts[#parts + 1] = "Сейф +" .. fmt(safeRate() * 60) .. "/мин" end
	if G.streak >= 2 then parts[#parts + 1] = "КОМБО x" .. string.format("%.2f", comboMult()) end
	if data.mult > 0 then parts[#parts + 1] = "Монеты x" .. string.format("%.1f", coinMult()) end
	UI.incomeLabel.Text = table.concat(parts, "   |   ")
end
hooks.hud = updateHud

