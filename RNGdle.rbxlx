----------------------------------------------------------------
-- ЕЖЕДНЕВНЫЙ ПОДАРОК
----------------------------------------------------------------
local DAILY = { 200, 400, 700, 1200, 2000, 3500, 7777 }
local DAILY_SECS = 20 * 3600

local function dailyState()
	local elapsed = os.time() - data.lastDaily
	local streak = data.dailyStreak
	if data.lastDaily == 0 or elapsed > 48 * 3600 then streak = 0 end
	local ready = data.lastDaily == 0 or elapsed >= DAILY_SECS
	return ready, streak, math.max(0, DAILY_SECS - elapsed)
end

local gift = makePanel("ЕЖЕДНЕВНЫЙ ПОДАРОК")
function gift.refresh()
	clearList(gift.list)
	local ready, streak, left = dailyState()
	local day = streak % 7 + 1
	local hdr = row(gift.list, 92, 0)
	simpleText(hdr, ready and ("Подарок готов! День " .. day .. " из 7: +" .. fmt(DAILY[day]) .. " монет")
		or ("Следующий подарок через " .. fmtTime(left)),
		UDim2.new(0, 14, 0, 12), UDim2.new(1, -190, 0, 66), 18, ready and GOLD or WHITE, Enum.Font.GothamBold)
	local b = button(hdr, ready and "ЗАБРАТЬ" or "ЖДИ...", ready and Color3.fromRGB(46, 190, 100) or Color3.fromRGB(64, 64, 70), {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 150, 0, 52),
	})
	b.MouseButton1Click:Connect(function()
		local rd, st = dailyState()
		if not rd then return end
		local d = st % 7 + 1
		addCoins(DAILY[d])
		data.dailyStreak = st + 1
		data.lastDaily = os.time()
		data.dailyClaims = data.dailyClaims + 1
		toast("Подарок дня " .. d .. ": +" .. fmt(DAILY[d]) .. " монет!", GOLD)
		local cx, cy = FX.center()
		FX.burst(cx, cy, d * 8, { GOLD, WHITE }, 200, 600, "coin")
		if d == 7 then
			FX.sevens(4)
		else
			FX.ring(cx, cy, GOLD, 600, 0.7, 8)
		end
		updateHud()
		checkAch()
		gift.refresh()
	end)
	for i = 1, 7 do
		local r = row(gift.list, 48, i)
		local isDone = ready and (i < day) or ((not ready) and (i <= streak % 7))
		local isCur = ready and i == day
		if isCur then stroke(r, GOLD, 3) end
		simpleText(r, "День " .. i .. (i == 7 and "  (СЕМЁРКА!)" or ""), UDim2.new(0, 14, 0, 13), UDim2.new(0.5, 0, 0, 22), 18,
			isDone and Color3.fromRGB(120, 230, 150) or WHITE, Enum.Font.GothamBlack)
		simpleText(r, (isDone and "ПОЛУЧЕНО  " or "") .. "+" .. fmt(DAILY[i]), UDim2.new(0.5, 0, 0, 13), UDim2.new(0.5, -14, 0, 22), 18,
			isDone and Color3.fromRGB(120, 230, 150) or GOLD, Enum.Font.GothamBlack, Enum.TextXAlignment.Right)
	end
end

----------------------------------------------------------------
-- ИГРОВАЯ ЛОГИКА (часть B): слот, золотые монеты, крутка, циклы
----------------------------------------------------------------

----------------------------------------------------------------
-- ЛАКИ-СЛОТ 777
----------------------------------------------------------------
local SLOT_SYMS = {
	{ s = "7", w = 2, color = Color3.fromRGB(255, 70, 90) },
	{ s = "$", w = 3, color = Color3.fromRGB(80, 230, 120) },
	{ s = "#", w = 4, color = Color3.fromRGB(80, 170, 255) },
	{ s = "&", w = 5, color = Color3.fromRGB(190, 100, 255) },
	{ s = "%", w = 6, color = Color3.fromRGB(255, 190, 60) },
}
local SLOT_COST = 100
local SLOT_COOLDOWN = 300

local function pickSym()
	local r = math.random(1, 20)
	local acc = 0
	for i, s in ipairs(SLOT_SYMS) do
		acc = acc + s.w
		if r <= acc then return i end
	end
	return 5
end

-- возвращает базовый приз и описание
local function slotPayout(res)
	local c7 = 0
	local cnt = {}
	for i = 1, 3 do
		if res[i] == 1 then c7 = c7 + 1 end
		cnt[res[i]] = (cnt[res[i]] or 0) + 1
	end
	local triple, pair = false, false
	for k, v in pairs(cnt) do
		if k ~= 1 and v == 3 then triple = true end
		if k ~= 1 and v == 2 then pair = true end
	end
	if c7 == 3 then return 7777, "ДЖЕКПОТ 7-7-7!!!", "jackpot" end
	if c7 == 2 then return 300, "Две семёрки!", "big" end
	if triple then return 500, "Три одинаковых!", "big" end
	if c7 == 1 and pair then return 70, "Семёрка и пара", "small" end
	if c7 == 1 then return 30, "Счастливая семёрка", "small" end
	if pair then return 40, "Пара", "small" end
	return 0, "Не повезло... попробуй ещё!", "none"
end

local slot = makePanel("ЛАКИ-СЛОТ 777")
local slotUI = { reels = {} }

local function slotFree()
	return os.time() - data.lastSlot >= SLOT_COOLDOWN
end

local function slotStatusText()
	if slotFree() then return "Бесплатный спин готов!" end
	return "Бесплатный спин через " .. fmtTime(SLOT_COOLDOWN - (os.time() - data.lastSlot))
		.. "  •  платный спин: " .. SLOT_COST .. " монет"
end

local function slotSpin()
	if G.slotBusy then return end
	local free = slotFree()
	if free then
		data.lastSlot = os.time()
	elseif data.coins >= SLOT_COST then
		data.coins = data.coins - SLOT_COST
	else
		toast("Не хватает монет для спина (нужно " .. SLOT_COST .. ")", Color3.fromRGB(255, 120, 120))
		return
	end
	G.slotBusy = true
	data.slotSpins = data.slotSpins + 1
	dirty = true
	updateHud()
	if slotUI.status and slotUI.status.Parent then slotUI.status.Text = "Крутим..." end
	if slotUI.btn and slotUI.btn.Parent then slotUI.btn.Text = "..." end

	local res = { pickSym(), pickSym(), pickSym() }
	local stopAt = { 10, 17, 25 }
	local tease = (res[1] == 1 and res[2] == 1)
	if tease then stopAt[3] = 42 end
	for step = 1, stopAt[3] do
		for r = 1, 3 do
			local lbl = slotUI.reels[r]
			if lbl and lbl.Parent then
				if step < stopAt[r] then
					local k = pickSym()
					lbl.Text = SLOT_SYMS[k].s
					lbl.TextColor3 = SLOT_SYMS[k].color
				elseif step == stopAt[r] then
					lbl.Text = SLOT_SYMS[res[r]].s
					lbl.TextColor3 = SLOT_SYMS[res[r]].color
					local sc = lbl.Parent:FindFirstChildOfClass("UIScale")
					if sc then
						sc.Scale = 1.3
						TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
					end
					FX.sound("stop", 1)
				end
			end
		end
		if tease and step > 24 then
			-- напряжение: две семёрки уже стоят, ждём третью
			if step % 4 == 0 then FX.shake(5, 0.2) end
			task.wait(0.11)
		else
			task.wait(0.055)
		end
	end

	local base, text, kind = slotPayout(res)
	local prize = math.floor(base * coinMult())
	if prize > 0 then addCoins(prize) end
	if kind == "jackpot" then
		data.slotJackpots = data.slotJackpots + 1
		FX.jackpot()
		toast("ДЖЕКПОТ!!! +" .. fmt(prize) .. " монет", GOLD)
	elseif kind == "big" then
		local cx, cy = FX.center()
		FX.burst(cx, cy, 40, { GOLD, WHITE }, 250, 700, "coin")
		FX.ring(cx, cy, GOLD, 800, 0.8, 10)
		FX.flash(GOLD, 0.25, 0.6)
		FX.shake(8, 0.5)
		toast(text .. " +" .. fmt(prize), GOLD)
	elseif kind == "small" then
		local cx, cy = FX.center()
		FX.burst(cx, cy, 10, { GOLD }, 150, 400, "coin")
		toast(text .. " +" .. fmt(prize), Color3.fromRGB(180, 230, 255))
	end
	if slotUI.status and slotUI.status.Parent then
		slotUI.status.Text = text .. (prize > 0 and ("   +" .. fmt(prize)) or "")
	end
	G.slotBusy = false
	updateHud()
	checkAch()
	if slot.isOpen then
		-- обновим кнопку, но оставим барабаны как есть
		if slotUI.btn and slotUI.btn.Parent then
			slotUI.btn.Text = slotFree() and "КРУТИТЬ (бесплатно)" or ("КРУТИТЬ (" .. SLOT_COST .. ")")
		end
	end
end

function slot.refresh()
	clearList(slot.list)
	slotUI.reels = {}
	local r1 = row(slot.list, 170, 1)
	local hold = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -20, 1, -20), BackgroundTransparency = 1,
	}, r1)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 14),
	}, hold)
	for i = 1, 3 do
		local box = make("Frame", {
			Size = UDim2.fromOffset(110, 130), BackgroundColor3 = Color3.fromRGB(9, 9, 10),
			BorderSizePixel = 0, LayoutOrder = i,
		}, hold)
		corner(box, 0.12)
		stroke(box, GOLD, 4)
		make("UIScale", {}, box)
		slotUI.reels[i] = label(box, {
			Text = "7", Font = Enum.Font.GothamBlack, Size = UDim2.fromScale(1, 1),
			TextColor3 = SLOT_SYMS[1].color,
		}, 110)
		make("UIPadding", { PaddingTop = UDim.new(0.1, 0), PaddingBottom = UDim.new(0.1, 0) }, slotUI.reels[i])
	end

	local r2 = row(slot.list, 84, 2)
	slotUI.status = simpleText(r2, slotStatusText(), UDim2.new(0, 14, 0, 14), UDim2.new(1, -250, 0, 60), 16,
		WHITE, Enum.Font.GothamBold)
	slotUI.btn = button(r2, slotFree() and "КРУТИТЬ (бесплатно)" or ("КРУТИТЬ (" .. SLOT_COST .. ")"),
		Color3.fromRGB(230, 60, 90), {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 220, 0, 56),
	})
	slotUI.btn.MouseButton1Click:Connect(function() task.spawn(slotSpin) end)

	local r3 = row(slot.list, 190, 3)
	simpleText(r3,
		"ВЫПЛАТЫ (умножаются на твой множитель монет):\n"
		.. "7 - 7 - 7  =  ДЖЕКПОТ 7 777\n"
		.. "7 - 7 - любой  =  300\n"
		.. "три одинаковых (не 7)  =  500\n"
		.. "семёрка + пара  =  70\n"
		.. "пара  =  40\n"
		.. "одна семёрка  =  30\n\n"
		.. "Бесплатный спин каждые 5 минут.",
		UDim2.new(0, 14, 0, 10), UDim2.new(1, -28, 1, -20), 15, Color3.fromRGB(208, 208, 212), Enum.Font.GothamBold)
end

----------------------------------------------------------------
-- ЗОЛОТАЯ МОНЕТА: иногда появляется на экране — успей нажать!
----------------------------------------------------------------
local function spawnGolden()
	local v = gui.AbsoluteSize
	local size = math.clamp(math.min(v.X, v.Y) * 0.13, 58, 96)
	local super = math.random(1, 7) == 7
	local x = size + math.random() * math.max(10, v.X - size * 2)
	local y = v.Y * 0.2 + math.random() * v.Y * 0.6
	local b = make("TextButton", {
		Text = super and "777" or "7", Font = Enum.Font.GothamBlack, TextScaled = true,
		TextColor3 = Color3.fromRGB(120, 60, 0), AutoButtonColor = false,
		BackgroundColor3 = super and Color3.fromRGB(255, 120, 220) or GOLD,
		Size = UDim2.fromOffset(size, size), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y), ZIndex = 30, BorderSizePixel = 0,
	}, gui)
	corner(b, 0.5)
	stroke(b, Color3.fromRGB(255, 250, 190), 4)
	make("UIPadding", {
		PaddingTop = UDim.new(0.22, 0), PaddingBottom = UDim.new(0.22, 0),
		PaddingLeft = UDim.new(0.15, 0), PaddingRight = UDim.new(0.15, 0),
	}, b)
	local sc = make("UIScale", { Scale = 0.1 }, b)
	TweenService:Create(sc, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(0.45, function()
		if b.Parent then
			TweenService:Create(sc, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.15 }):Play()
		end
	end)
	FX.ring(x, y, super and Color3.fromRGB(255, 120, 220) or GOLD, 200, 0.6, 5)

	local alive = true
	b.MouseButton1Click:Connect(function()
		if not alive then return end
		alive = false
		local reward = math.floor((77 + data.rolls * 0.5) * coinMult() * (super and 10 or 1))
		addCoins(reward)
		data.golden = data.golden + 1
		FX.burst(x, y, super and 40 or 18, { GOLD, WHITE }, 200, 600, "coin")
		FX.ring(x, y, GOLD, 360, 0.6, 7)
		FX.sound("coin", 1)
		if super then
			FX.flash(GOLD, 0.25, 0.6)
			FX.shake(6, 0.4)
		end
		toast((super and "СУПЕР-МОНЕТА 777! +" or "Золотая монета! +") .. fmt(reward), GOLD)
		b:Destroy()
		updateHud()
		checkAch()
	end)
	task.delay(9, function()
		if alive and b.Parent then
			alive = false
			TweenService:Create(sc, TweenInfo.new(0.4), { Scale = 0 }):Play()
			task.delay(0.45, function() b:Destroy() end)
		end
	end)
end

----------------------------------------------------------------
-- КРУТКА
----------------------------------------------------------------
local function randomNumber()
	local t = {}
	local chance = data.magnet * 0.03
	for i = 1, 6 do
		if chance > 0 and math.random() < chance then
			t[i] = "7"
		else
			t[i] = tostring(math.random(0, 9))
		end
	end
	return table.concat(t)
end

local function rollOnce()
	local bestN, bestT, bestWhy
	for _ = 1, 1 + data.luck do
		local n = randomNumber()
		local t, why = classify(n)
		if not bestN or t > bestT then bestN, bestT, bestWhy = n, t, why end
	end
	return bestN, bestT, bestWhy
end

local function resetBoxes()
	FX.rainbowUntil = 0
	for i = 1, 6 do
		UI.boxStrokes[i].Color = BOX_STROKE
		UI.boxStrokes[i].Thickness = 3
		UI.digits[i].TextColor3 = DIM
	end
end

local function pop(i)
	UI.boxScales[i].Scale = 1.25
	TweenService:Create(UI.boxScales[i], TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function floatText(text, color, x, y0, y1, size)
	local l = label(stage, {
		Text = text, Font = Enum.Font.GothamBlack, TextColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y0), Size = UDim2.fromScale(0.5, 0.06),
		ZIndex = 5,
	}, size or 36)
	l.TextStrokeTransparency = 0.4
	TweenService:Create(l, TweenInfo.new(1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.fromScale(x, y1), TextTransparency = 1, TextStrokeTransparency = 1,
	}):Play()
	Debris:AddItem(l, 1.4)
end

local function showResult(num, tier, why, bonuses, mult)
	local t = TIERS[tier]
	FX.resultColor = (tier == 7) and WHITE or t.color
	UI.rarityGrad.Enabled = (tier >= 6)
	UI.rarityLabel.TextColor3 = (tier >= 6) and WHITE or t.color
	UI.rarityLabel.Text = t.name
	UI.rarityLabel.TextTransparency = 0
	UI.rarityStroke.Thickness = (tier >= 4) and 3 or 0
	UI.whyLabel.Text = why .. "  •  шанс 1 из " .. fmt(t.odds)
	UI.whyLabel.TextColor3 = (tier >= 6) and WHITE or t.color
	for i = 1, 6 do
		UI.boxStrokes[i].Color = FX.resultColor
		UI.digits[i].TextColor3 = (tier >= 2) and FX.resultColor or WHITE
	end
	-- заголовок: падает сверху огромным и отскакивает
	UI.rarityScale.Scale = (tier >= 5) and 3.2 or 0.7
	TweenService:Create(UI.rarityScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	if tier >= 6 then
		task.spawn(function()
			local t0 = tick()
			while tick() - t0 < 2.5 do
				UI.rarityLabel.Rotation = (math.random() - 0.5) * 5
				task.wait(0.04)
			end
			UI.rarityLabel.Rotation = 0
		end)
	end

	-- бонусы
	if #bonuses > 0 then
		local names = {}
		for i = 1, math.min(3, #bonuses) do names[i] = bonuses[i].name end
		local txt = "БОНУС: " .. table.concat(names, "  •  ")
		if #bonuses > 3 then txt = txt .. "  •  +" .. (#bonuses - 3) .. " ещё" end
		UI.bonusLabel.Text = txt
	else
		UI.bonusLabel.Text = ""
	end

	FX.play(tier)
	local _, c7 = num:gsub("7", "")
	if c7 >= 1 and tier <= 4 then FX.sevens(c7) end
	for i, b in ipairs(bonuses) do
		if i <= 5 then
			task.delay(0.18 * i, function()
				floatText("+" .. fmt(b.coins * mult) .. "  " .. b.name, GOLD, 0.3 + math.random() * 0.4, 0.58, 0.47, 24)
			end)
		end
	end
end

local function rollInner()
	local num, tier, why = rollOnce()
	local bonuses = findBonuses(num)
	local gap = math.max(0.08, 0.38 - data.speed * 0.06)
	local stopped = {}
	local spinning = true
	FX.sound("roll", 1)

	task.spawn(function()
		while spinning do
			for i = 1, 6 do
				if not stopped[i] then UI.digits[i].Text = tostring(math.random(0, 9)) end
			end
			task.wait(0.045)
		end
	end)

	local tcol = TIERS[tier].color
	for i = 1, 6 do
		local w = gap
		if tier >= 5 and i >= 5 then w = gap * 3 end
		if tier >= 6 and i == 6 then w = gap * 5 end
		if tier >= 6 and i == 6 then
			-- затишье перед бурей: экран темнеет и дрожит
			FX.tint(Color3.new(0, 0, 0), 0.35, w)
			FX.shake(4, w)
		end
		task.wait(w)
		stopped[i] = true
		UI.digits[i].Text = num:sub(i, i)
		UI.digits[i].TextColor3 = WHITE
		-- подсказка судьбы: рамки начинают светиться цветом редкости
		if tier >= 4 and i >= 4 then UI.boxStrokes[i - 3].Color = tcol end
		pop(i)
		FX.sound("stop", 1)
	end
	spinning = false

	-- данные и монеты
	local t = TIERS[tier]
	if tier >= 2 then G.streak = G.streak + 1 else G.streak = 0 end
	local bonusCoins = 0
	for _, b in ipairs(bonuses) do
		bonusCoins = bonusCoins + b.coins
		data.bonus[b.id] = (data.bonus[b.id] or 0) + 1
	end
	local mult = coinMult() * comboMult()
	local total = math.floor((t.coins + bonusCoins) * mult)
	data.rolls = data.rolls + 1
	addCoins(total)
	data.found[t.id] = (data.found[t.id] or 0) + 1
	if tier >= data.best.t then data.best = { n = num, t = tier } end
	table.insert(data.history, 1, { n = num, t = tier, why = why })
	while #data.history > 25 do table.remove(data.history) end
	G.last = { n = num, t = tier, why = why }

	showResult(num, tier, why, bonuses, mult)
	floatText("+" .. fmt(total), GOLD, 0.5, 0.585, 0.5, 44)
	FX.sound("coin", 0.6)

	UI.saveBtn.Visible = true
	if inSafe(num) then
		UI.saveBtn.Text = "В СЕЙФЕ"
		UI.saveBtn.BackgroundColor3 = Color3.fromRGB(64, 64, 70)
	else
		UI.saveBtn.Text = "В СЕЙФ"
		UI.saveBtn.BackgroundColor3 = Color3.fromRGB(235, 170, 40)
	end

	updateHud()
	checkAch()
	updateHud()
end

local function roll()
	if G.rolling then return end
	G.rolling = true
	UI.rollBtn.Text = "..."
	UI.rollBtn.BackgroundColor3 = Color3.fromRGB(56, 56, 62)
	resetBoxes()
	UI.rarityLabel.Text = "КРУТИМ..."
	UI.rarityLabel.TextColor3 = DIM
	UI.rarityLabel.Rotation = 0
	UI.rarityStroke.Thickness = 0
	UI.rarityGrad.Enabled = false
	UI.whyLabel.Text = " "
	UI.bonusLabel.Text = ""
	UI.saveBtn.Visible = false

	local ok, err = pcall(rollInner)
	if not ok then warn("[RNGdle] Ошибка крутки: " .. tostring(err)) end

	G.rolling = false
	UI.rollBtn.Text = "КРУТИТЬ"
	UI.rollBtn.BackgroundColor3 = Color3.fromRGB(46, 190, 100)
end

UI.rollBtn.MouseButton1Click:Connect(roll)
UI.saveBtn.MouseButton1Click:Connect(function()
	if G.last and not inSafe(G.last.n) then
		trySave(G.last)
		if inSafe(G.last.n) then
			UI.saveBtn.Text = "В СЕЙФЕ"
			UI.saveBtn.BackgroundColor3 = Color3.fromRGB(64, 64, 70)
		end
	end
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.Space and not anyPanelOpen then roll() end
	if input.KeyCode == Enum.KeyCode.F and not anyPanelOpen and G.last and not inSafe(G.last.n) and not G.rolling then
		trySave(G.last)
		if inSafe(G.last.n) then
			UI.saveBtn.Text = "В СЕЙФЕ"
			UI.saveBtn.BackgroundColor3 = Color3.fromRGB(64, 64, 70)
		end
	end
end)

----------------------------------------------------------------
-- АВТО
----------------------------------------------------------------
local function refreshAutoBtn()
	if not data.auto then
		UI.autoBtn.Text = "АВТО: ЗАКРЫТО"
		UI.autoBtn.BackgroundColor3 = Color3.fromRGB(56, 56, 62)
	elseif G.autoOn then
		UI.autoBtn.Text = "АВТО: ВКЛ"
		UI.autoBtn.BackgroundColor3 = Color3.fromRGB(46, 190, 100)
	else
		UI.autoBtn.Text = "АВТО: ВЫКЛ"
		UI.autoBtn.BackgroundColor3 = Color3.fromRGB(78, 78, 86)
	end
end
hooks.auto = refreshAutoBtn

UI.autoBtn.MouseButton1Click:Connect(function()
	if not data.auto then
		shop.open()
		return
	end
	G.autoOn = not G.autoOn
	refreshAutoBtn()
end)

----------------------------------------------------------------
-- КНОПКИ МЕНЮ
----------------------------------------------------------------
UI.btnShop.MouseButton1Click:Connect(shop.open)
UI.btnSafe.MouseButton1Click:Connect(safePanel.open)
UI.btnSlot.MouseButton1Click:Connect(slot.open)
UI.btnGift.MouseButton1Click:Connect(gift.open)
UI.btnColl.MouseButton1Click:Connect(collection.open)
UI.btnBonus.MouseButton1Click:Connect(bonusPanel.open)
UI.btnAch.MouseButton1Click:Connect(achPanel.open)
UI.btnHist.MouseButton1Click:Connect(history.open)

----------------------------------------------------------------
-- ФОНОВЫЕ ЦИКЛЫ
----------------------------------------------------------------
-- автокрутка
task.spawn(function()
	while true do
		task.wait(0.35)
		if G.autoOn and not G.rolling and not anyPanelOpen then roll() end
	end
end)

-- каждую секунду: шахта, таймеры, значки, живые тексты панелей
task.spawn(function()
	while true do
		task.wait(1)
		local mr = minerRate()
		if mr > 0 then
			addCoins(mr)
			updateHud()
		end
		UI.badgeGift.Visible = dailyState()
		UI.badgeSlot.Visible = slotFree()
		if safePanel.isOpen and safeUI.info and safeUI.info.Parent then
			safeUI.info.Text = safeInfoText()
		end
		if slot.isOpen and not G.slotBusy and slotUI.status and slotUI.status.Parent then
			slotUI.status.Text = slotStatusText()
			if slotUI.btn and slotUI.btn.Parent then
				slotUI.btn.Text = slotFree() and "КРУТИТЬ (бесплатно)" or ("КРУТИТЬ (" .. SLOT_COST .. ")")
			end
		end
		if gift.isOpen then
			local _, _, left = dailyState()
			if left > 0 and left < DAILY_SECS then gift.refresh() end
		end
		checkAch()
	end
end)

-- золотые монеты
task.spawn(function()
	task.wait(15)
	while true do
		local ok, err = pcall(spawnGolden)
		if not ok then warn("[RNGdle] золотая монета: " .. tostring(err)) end
		task.wait(25 + math.random() * 30)
	end
end)

hooks.hud = function()
	updateHud()
	refreshAutoBtn()
end

refreshAutoBtn()
updateHud()

end)

if not __ok then
	warn("[RNGdle] ОШИБКА: " .. tostring(__err))
	pcall(function()
		local pg = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
		local prev = pg:FindFirstChild("RNGdleError")
		if prev then prev:Destroy() end
		local sg = Instance.new("ScreenGui")
		sg.Name = "RNGdleError"
		sg.DisplayOrder = 999
		sg.ResetOnSpawn = false
		sg.IgnoreGuiInset = true
		sg.Parent = pg
		local f = Instance.new("Frame")
		f.Size = UDim2.fromScale(1, 1)
		f.BackgroundColor3 = Color3.fromRGB(60, 10, 20)
		f.BorderSizePixel = 0
		f.Parent = sg
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(0.9, 0.8)
		t.Position = UDim2.fromScale(0.05, 0.1)
		t.BackgroundTransparency = 1
		t.Text = "ОШИБКА RNGdle (скинь этот текст разработчику):\n" .. tostring(__err)
		t.TextColor3 = Color3.new(1, 1, 1)
		t.TextSize = 20
		t.TextWrapped = true
		t.Font = Enum.Font.GothamBold
		t.Parent = f
	end)
end
]]></ProtectedString></Properties></Item></Item></Item>
