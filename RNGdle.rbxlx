	{ id = "r10000", name = "Легенда RNG",       desc = "Сделай 10 000 круток",          goal = 10000,    reward = 50000,  get = function() return data.rolls end },
	{ id = "e1k",    name = "Копилка",           desc = "Заработай 1 000 монет",         goal = 1000,     reward = 100,    get = function() return data.earned end },
	{ id = "e100k",  name = "Богач",             desc = "Заработай 100 000 монет",       goal = 100000,   reward = 2000,   get = function() return data.earned end },
	{ id = "e10m",   name = "Магнат",            desc = "Заработай 10 000 000 монет",    goal = 10000000, reward = 100000, get = function() return data.earned end },
	{ id = "t3",     name = "Редкая находка",    desc = "Выбей РЕДКОЕ или лучше",        goal = 1,        reward = 200,    get = function() return foundAtLeast(3) end },
	{ id = "t4",     name = "Эпик!",             desc = "Выбей ЭПИЧЕСКОЕ или лучше",     goal = 1,        reward = 1000,   get = function() return foundAtLeast(4) end },
	{ id = "t5",     name = "Легенда",           desc = "Выбей ЛЕГЕНДАРНОЕ или лучше",   goal = 1,        reward = 5000,   get = function() return foundAtLeast(5) end },
	{ id = "t6",     name = "Миф",               desc = "Выбей МИФИЧЕСКОЕ или лучше",    goal = 1,        reward = 25000,  get = function() return foundAtLeast(6) end },
