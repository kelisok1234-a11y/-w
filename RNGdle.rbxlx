local safePanel = makePanel("СЕЙФ ЛУЧШИХ ЧИСЕЛ")
local safeUI = {}

local function safeInfoText()
	return "Слотов: " .. #data.safe .. "/" .. safeCapacity()
		.. "\nДоход сейфа: +" .. fmt(safeRate() * 60) .. " монет/мин"
		.. "\nНакоплено: " .. fmt(safePending()) .. "  (копится до 8 часов)"
end

function safePanel.refresh()
	clearList(safePanel.list)
	local hdr = row(safePanel.list, 92, 0)
	safeUI.info = simpleText(hdr, safeInfoText(), UDim2.new(0, 14, 0, 8), UDim2.new(1, -190, 0, 78), 16,
		WHITE, Enum.Font.GothamBold)
	local claim = button(hdr, "ЗАБРАТЬ", Color3.fromRGB(46, 190, 100), {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 150, 0, 52),
	})
	claim.MouseButton1Click:Connect(function()
		local p = claimSafe()
		if p > 0 then
			toast("Из сейфа: +" .. fmt(p) .. " монет", GOLD)
			local cx, cy = FX.center()
			FX.burst(cx, cy, 24, { GOLD }, 200, 520, "coin")
			FX.sound("coin", 1)
		end
		updateHud()
		checkAch()
		safePanel.refresh()
	end)

	local hint = row(safePanel.list, 44, 1)
	simpleText(hint, "Нажми «В СЕЙФ» (или клавишу F) после крутки, чтобы сохранить число. Чем реже число — тем больше оно приносит.",
		UDim2.new(0, 14, 0, 5), UDim2.new(1, -28, 0, 36), 13, Color3.fromRGB(155, 155, 160), Enum.Font.Gotham)

	for i, e in ipairs(data.safe) do
		local t = TIERS[e.t] or TIERS[1]
		local r = row(safePanel.list, 68, 10 + i)
		stroke(r, t.color, 2)
		simpleText(r, e.n, UDim2.new(0, 14, 0, 6), UDim2.new(0.34, 0, 0, 34), 30, t.color, Enum.Font.GothamBlack)
		simpleText(r, t.name .. ((e.why and e.why ~= "") and ("  •  " .. e.why) or ""),
			UDim2.new(0, 14, 0, 42), UDim2.new(0.6, 0, 0, 20), 13, Color3.fromRGB(196, 196, 200), Enum.Font.GothamBold)
		local rate = math.max(1, math.floor(t.coins * 0.02)) * 2
		simpleText(r, "+" .. fmt(rate) .. " монет/мин", UDim2.new(0.38, 0, 0, 14), UDim2.new(0.26, 0, 0, 22), 15,
			GOLD, Enum.Font.GothamBold)
		local armed = false
		local rm = button(r, "УБРАТЬ", Color3.fromRGB(150, 60, 70), {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.new(0, 96, 0, 36), TextScaled = false, TextSize = 14,
		})
		rm.MouseButton1Click:Connect(function()
			if not armed then
				armed = true
				rm.Text = "ТОЧНО?"
				rm.BackgroundColor3 = Color3.fromRGB(220, 60, 70)
				task.delay(2.5, function()
					if rm.Parent then
						armed = false
						rm.Text = "УБРАТЬ"
						rm.BackgroundColor3 = Color3.fromRGB(150, 60, 70)
					end
				end)
				return
			end
			settleSafe()
			for k, s in ipairs(data.safe) do
				if s.n == e.n then table.remove(data.safe, k) break end
			end
			dirty = true
			updateHud()
			safePanel.refresh()
		end)
	end

	local empty = safeCapacity() - #data.safe
	for i = 1, math.min(empty, 3) do
		local r = row(safePanel.list, 44, 500 + i)
		r.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
		simpleText(r, "— пустой слот —", UDim2.new(0, 14, 0, 12), UDim2.new(1, -28, 0, 22), 16,
			Color3.fromRGB(88, 88, 94), Enum.Font.GothamBold)
	end
	if empty > 3 then
		local r = row(safePanel.list, 36, 600)
		r.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
		simpleText(r, "...и ещё " .. (empty - 3) .. " пустых слотов", UDim2.new(0, 14, 0, 8), UDim2.new(1, -28, 0, 20), 14,
			Color3.fromRGB(88, 88, 94), Enum.Font.GothamBold)
	end
end

local function trySave(e)
	if not e then
		toast("Сначала крутани число!", Color3.fromRGB(255, 120, 120))
		return
	end
	local ok, msg = addToSafe(e)
	toast(msg, ok and GOLD or Color3.fromRGB(255, 120, 120))
	if ok then
		local cx, cy = FX.center()
		FX.ring(cx, cy, GOLD, 420, 0.5, 6)
		FX.burst(cx, cy, 14, { GOLD, WHITE }, 150, 380, "square")
		FX.sound("click", 1)
	end
	updateHud()
	checkAch()
	if safePanel.isOpen then safePanel.refresh() end
end

