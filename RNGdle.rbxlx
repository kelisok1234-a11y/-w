----------------------------------------------------------------
-- ПАНЕЛИ
----------------------------------------------------------------
local anyPanelOpen = false
local panels = {}

local function makePanel(title)
	local overlay = make("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35,
		Text = "", AutoButtonColor = false, Visible = false, ZIndex = 20, BorderSizePixel = 0,
	}, gui)
	local frame = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.86, 0.84), BackgroundColor3 = Color3.fromRGB(20, 22, 42),
		BorderSizePixel = 0, Active = true,
	}, overlay)
	corner(frame, 0.03)
	stroke(frame, Color3.fromRGB(90, 96, 150), 3)
	make("UISizeConstraint", { MaxSize = Vector2.new(760, 560) }, frame)

	label(frame, {
		Text = title, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromScale(0.04, 0.02), Size = UDim2.fromScale(0.7, 0.1),
	}, 36)

	local close = button(frame, "X", Color3.fromRGB(220, 60, 70), {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(44, 44),
	})

	local list = make("ScrollingFrame", {
		Position = UDim2.fromScale(0.03, 0.15), Size = UDim2.fromScale(0.94, 0.82),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y,
	}, frame)
	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)

	local panel = { overlay = overlay, list = list }
	function panel.open()
		if panel.refresh then panel.refresh() end
		overlay.Visible = true
		anyPanelOpen = true
	end
	function panel.close()
		overlay.Visible = false
		anyPanelOpen = false
	end
	close.MouseButton1Click:Connect(panel.close)
	overlay.MouseButton1Click:Connect(function(x, y)
		-- закрываем только по клику вне окна, чтобы не мешать кнопкам внутри
		local p, s = frame.AbsolutePosition, frame.AbsoluteSize
		if x < p.X or x > p.X + s.X or y < p.Y or y > p.Y + s.Y then
			panel.close()
		end
	end)
	panels[#panels + 1] = panel
	return panel
end

local function clearList(list)
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
end

local function row(list, height, order)
	local r = make("Frame", {
		Size = UDim2.new(1, -10, 0, height), BackgroundColor3 = Color3.fromRGB(32, 35, 64),
		BorderSizePixel = 0, LayoutOrder = order,
	}, list)
	corner(r, 0.12)
	return r
end

local function simpleText(parent, text, pos, size, textSize, color, font, xalign)
	return make("TextLabel", {
		BackgroundTransparency = 1, Text = text, Position = pos, Size = size, TextSize = textSize,
		TextColor3 = color or WHITE, Font = font or Enum.Font.GothamBold, TextWrapped = true,
		TextXAlignment = xalign or Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
	}, parent)
end

local function updateHud()
	coinsLabel.Text = "МОНЕТЫ: " .. fmt(data.coins)
	local best = data.best
	local bestTxt = "—"
	if best.t > 0 then
		bestTxt = best.n .. " (" .. TIERS[best.t].name .. ")"
	end
	statsLabel.Text = "Круток: " .. fmt(data.rolls) .. "   |   Лучшее: " .. bestTxt .. "   |   Удача: +" .. data.luck
end
hooks.hud = updateHud

-- МАГАЗИН
local SHOP = {
	{ key = "luck", name = "Удача", max = 10,
		desc = "+1 попытка за уровень: игра выбирает лучшее из нескольких чисел.",
		cost = function(l) return math.floor(40 * 1.9 ^ l) end },
	{ key = "speed", name = "Скорость", max = 5,
		desc = "Цифры останавливаются быстрее.",
		cost = function(l) return math.floor(150 * 3 ^ l) end },
	{ key = "auto", name = "Автокрутка", max = 1,
		desc = "Открывает кнопку АВТО — игра крутит сама.",
		cost = function() return 300 end },
}

local shop = makePanel("МАГАЗИН")

local function itemLevel(item)
	if item.key == "auto" then return data.auto and 1 or 0 end
	return data[item.key]
end

function shop.refresh()
	clearList(shop.list)
	for i, item in ipairs(SHOP) do
		local lvl = itemLevel(item)
		local r = row(shop.list, 84, i)
		simpleText(r, item.name .. "  (ур. " .. lvl .. "/" .. item.max .. ")",
			UDim2.new(0, 14, 0, 8), UDim2.new(0.6, 0, 0, 26), 20)
		simpleText(r, item.desc, UDim2.new(0, 14, 0, 36), UDim2.new(0.6, 0, 0, 44), 14,
			Color3.fromRGB(170, 176, 200), Enum.Font.Gotham)
		local text, color
		if lvl >= item.max then
			text, color = "МАКС", Color3.fromRGB(80, 84, 110)
		else
			local cost = item.cost(lvl)
			text = fmt(cost) .. " монет"
			color = data.coins >= cost and Color3.fromRGB(46, 190, 100) or Color3.fromRGB(190, 70, 70)
		end
		local b = button(r, text, color, {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.new(0.3, 0, 0, 46), TextScaled = false, TextSize = 17,
		})
		b.MouseButton1Click:Connect(function()
			local l = itemLevel(item)
			if l >= item.max then return end
			local cost = item.cost(l)
			if data.coins < cost then return end
			data.coins -= cost
			if item.key == "auto" then data.auto = true else data[item.key] += 1 end
			dirty = true
			updateHud()
			shop.refresh()
			if item.key == "auto" then
				autoBtn.Text = "АВТО: ВЫКЛ"
				autoBtn.BackgroundColor3 = Color3.fromRGB(90, 94, 130)
			end
		end)
	end
end

-- КОЛЛЕКЦИЯ
local collection = makePanel("КОЛЛЕКЦИЯ РЕДКОСТЕЙ")
function collection.refresh()
	clearList(collection.list)
	for i, t in ipairs(TIERS) do
		local r = row(collection.list, 92, i)
		local bar = make("Frame", {
			Size = UDim2.new(0, 8, 1, -16), Position = UDim2.new(0, 8, 0, 8),
			BackgroundColor3 = t.color, BorderSizePixel = 0,
		}, r)
		corner(bar, 0.5)
		simpleText(r, t.name, UDim2.new(0, 28, 0, 8), UDim2.new(0.5, 0, 0, 26), 21, t.color, Enum.Font.GothamBlack)
		simpleText(r, "Шанс: 1 из " .. fmt(t.odds) .. "   |   Награда: " .. fmt(t.coins),
			UDim2.new(0, 28, 0, 34), UDim2.new(0.7, 0, 0, 18), 14, Color3.fromRGB(200, 205, 225), Enum.Font.GothamBold)
		simpleText(r, t.desc, UDim2.new(0, 28, 0, 54), UDim2.new(1, -150, 0, 34), 13,
			Color3.fromRGB(150, 156, 180), Enum.Font.Gotham)
		simpleText(r, "Найдено: " .. fmt(data.found[t.id] or 0), UDim2.new(1, -130, 0, 10),
			UDim2.new(0, 120, 0, 22), 16, WHITE, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
	end
end

-- ИСТОРИЯ
local history = makePanel("ПОСЛЕДНИЕ ВЫПАДЕНИЯ")
function history.refresh()
	clearList(history.list)
	if #data.history == 0 then
		local r = row(history.list, 50, 1)
		simpleText(r, "Пока пусто. Покрути!", UDim2.new(0, 14, 0, 14), UDim2.new(1, -28, 0, 24), 18)
		return
	end
	for i, h in ipairs(data.history) do
		local t = TIERS[h.t]
		local r = row(history.list, 46, i)
		simpleText(r, h.n, UDim2.new(0, 14, 0, 8), UDim2.new(0.4, 0, 0, 30), 26, t.color, Enum.Font.GothamBlack)
		simpleText(r, t.name, UDim2.new(1, -14, 0, 14), UDim2.new(0.5, 0, 0, 22), 17, t.color,
			Enum.Font.GothamBold, Enum.TextXAlignment.Right).AnchorPoint = Vector2.new(1, 0)
	end
end

shopBtn.MouseButton1Click:Connect(shop.open)
collBtn.MouseButton1Click:Connect(collection.open)
histBtn.MouseButton1Click:Connect(history.open)

----------------------------------------------------------------
-- РОЛЛ
----------------------------------------------------------------
local rolling = false
local autoOn = false

local function randomNumber()
	local t = {}
	for i = 1, 6 do t[i] = tostring(math.random(0, 9)) end
	return table.concat(t)
end

local function rollOnce()
	local bestN, bestT, bestWhy
	for _ = 1, 1 + data.luck do
		local n = randomNumber()
		local t, why = classify(n)
		if not bestN or t > bestT then bestN, bestT, bestWhy = n, t, why end
	end
	return bestN, bestT, bestWhy
end

local DIM = Color3.fromRGB(150, 156, 180)

local function resetBoxes()
	for i = 1, 6 do
		boxStrokes[i].Color = Color3.fromRGB(70, 76, 120)
		digitLabels[i].TextColor3 = DIM
	end
end

local function pop(i)
	boxScales[i].Scale = 1.25
	TweenService:Create(boxScales[i], TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function floatText(text, color)
	local l = label(gui, {
		Text = text, Font = Enum.Font.GothamBlack, TextColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.58), Size = UDim2.fromScale(0.4, 0.06),
		ZIndex = 5,
	}, 36)
	TweenService:Create(l, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.fromScale(0.5, 0.52), TextTransparency = 1,
	}):Play()
	task.delay(1.2, function() l:Destroy() end)
end

local function shake(power)
	task.spawn(function()
		local base = holder.Position
		for _ = 1, 14 do
			holder.Position = base + UDim2.fromOffset(math.random(-power, power), math.random(-power, power))
			task.wait(0.03)
		end
		holder.Position = base
	end)
end

local function doFlash(color, strength)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 1 - strength
	TweenService:Create(flash, TweenInfo.new(0.9), { BackgroundTransparency = 1 }):Play()
end

local function showResult(num, tier, why)
	local t = TIERS[tier]
	rarityGrad.Enabled = (tier == 7)
	rarityLabel.TextColor3 = (tier == 7) and WHITE or t.color
	rarityLabel.Text = t.name
	rarityLabel.TextTransparency = 0
	whyLabel.Text = why .. "  •  шанс 1 из " .. fmt(t.odds)
	whyLabel.TextColor3 = (tier == 7) and WHITE or t.color
	for i = 1, 6 do
		boxStrokes[i].Color = t.color
		digitLabels[i].TextColor3 = (tier >= 2) and t.color or WHITE
	end
	-- пульс заголовка
	local sc = rarityLabel:FindFirstChild("UIScale") or make("UIScale", {}, rarityLabel)
	sc.Scale = 0.7
	TweenService:Create(sc, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

	if tier >= 4 then doFlash(t.color, tier >= 6 and 0.6 or 0.35) end
	if tier >= 5 then shake(tier >= 6 and 14 or 8) end
	if tier >= 6 then
		task.delay(0.35, function() doFlash(WHITE, 0.4) end)
	end
end

local function roll()
	if rolling then return end
	rolling = true
	rollBtn.Text = "..."
	rollBtn.BackgroundColor3 = Color3.fromRGB(70, 74, 100)
	resetBoxes()
	rarityLabel.Text = "КРУТИМ..."
	rarityLabel.TextColor3 = DIM
	rarityGrad.Enabled = false
	whyLabel.Text = " "

	local num, tier, why = rollOnce()
	local gap = math.max(0.08, 0.38 - data.speed * 0.06)
	local stopped = {}
	local spinning = true

	task.spawn(function()
		while spinning do
			for i = 1, 6 do
				if not stopped[i] then digitLabels[i].Text = tostring(math.random(0, 9)) end
			end
			task.wait(0.045)
		end
	end)

	for i = 1, 6 do
		local wait = gap
		if tier >= 5 and i >= 5 then wait = gap * 3 end
		if tier >= 6 and i == 6 then wait = gap * 5 end
		task.wait(wait)
		stopped[i] = true
		digitLabels[i].Text = num:sub(i, i)
		digitLabels[i].TextColor3 = WHITE
		pop(i)
	end
	spinning = false

	-- данные
	local t = TIERS[tier]
	data.rolls += 1
	data.coins += t.coins
	data.found[t.id] = (data.found[t.id] or 0) + 1
	if tier >= data.best.t then data.best = { n = num, t = tier } end
	table.insert(data.history, 1, { n = num, t = tier })
	while #data.history > 25 do table.remove(data.history) end
	dirty = true

	showResult(num, tier, why)
	floatText("+" .. fmt(t.coins), Color3.fromRGB(255, 215, 90))
	updateHud()

	rolling = false
	rollBtn.Text = "КРУТИТЬ"
	rollBtn.BackgroundColor3 = Color3.fromRGB(46, 190, 100)
end

rollBtn.MouseButton1Click:Connect(roll)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.Space and not anyPanelOpen then roll() end
end)

local function refreshAutoBtn()
	if not data.auto then
		autoBtn.Text = "АВТО: ЗАКРЫТО"
		autoBtn.BackgroundColor3 = Color3.fromRGB(70, 74, 100)
	elseif autoOn then
		autoBtn.Text = "АВТО: ВКЛ"
		autoBtn.BackgroundColor3 = Color3.fromRGB(46, 190, 100)
	else
		autoBtn.Text = "АВТО: ВЫКЛ"
		autoBtn.BackgroundColor3 = Color3.fromRGB(90, 94, 130)
	end
end

hooks.auto = refreshAutoBtn

autoBtn.MouseButton1Click:Connect(function()
	if not data.auto then
		shop.open()
		return
	end
	autoOn = not autoOn
	refreshAutoBtn()
end)

task.spawn(function()
	while true do
		task.wait(0.35)
		if autoOn and not rolling and not anyPanelOpen then roll() end
	end
end)

refreshAutoBtn()
updateHud()

end)
if not __ok then
	warn("[RNGdle] ОШИБКА: " .. tostring(__err))
	pcall(function()
		local pg = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
		local prev = pg:FindFirstChild("RNGdleError")
		if prev then prev:Destroy() end
		local sg = Instance.new("ScreenGui")
		sg.Name = "RNGdleError"
		sg.DisplayOrder = 999
		sg.ResetOnSpawn = false
		sg.IgnoreGuiInset = true
		sg.Parent = pg
		local f = Instance.new("Frame")
		f.Size = UDim2.fromScale(1, 1)
		f.BackgroundColor3 = Color3.fromRGB(60, 10, 20)
		f.BorderSizePixel = 0
		f.Parent = sg
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(0.9, 0.8)
		t.Position = UDim2.fromScale(0.05, 0.1)
		t.BackgroundTransparency = 1
		t.Text = "ОШИБКА RNGdle (скинь этот текст разработчику):\n" .. tostring(__err)
		t.TextColor3 = Color3.new(1, 1, 1)
		t.TextSize = 20
		t.TextWrapped = true
		t.Font = Enum.Font.GothamBold
		t.Parent = f
	end)
end
]]></ProtectedString></Properties></Item></Item></Item>
</roblox>
