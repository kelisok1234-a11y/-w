<Item class="Workspace" referent="RBX0"><Properties><string name="Name">Workspace</string></Properties></Item>
<Item class="Players" referent="RBX1"><Properties><string name="Name">Players</string><bool name="CharacterAutoLoads">false</bool></Properties></Item>
<Item class="Lighting" referent="RBX2"><Properties><string name="Name">Lighting</string></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX3"><Properties><string name="Name">ReplicatedStorage</string></Properties></Item>
<Item class="ServerScriptService" referent="RBX5"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX4"><Properties><string name="Name">RNGdleServer</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- RNGdle 2D | Script (ServerScriptService)
-- Сохранение прогресса игрока через DataStore.

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

pcall(function()
	Players.CharacterAutoLoads = false -- 2D игра: персонаж не нужен
end)

local loadRemote = Instance.new("RemoteFunction")
loadRemote.Name = "LoadData"
loadRemote.Parent = ReplicatedStorage

local saveRemote = Instance.new("RemoteEvent")
saveRemote.Name = "SaveData"
saveRemote.Parent = ReplicatedStorage

local store
pcall(function()
	store = DataStoreService:GetDataStore("RNGdle_v1")
end)

local cache = {}

local function save(plr)
	local data = cache[plr]
	if store and data then
		local ok, err = pcall(function()
			store:SetAsync("player_" .. plr.UserId, data)
		end)
		if not ok then warn("[RNGdle] Не удалось сохранить: " .. tostring(err)) end
	end
end

loadRemote.OnServerInvoke = function(plr)
	local result
	if store then
		local ok, res = pcall(function()
			return store:GetAsync("player_" .. plr.UserId)
		end)
		if ok then result = res end
	end
	cache[plr] = result
	return result
end

saveRemote.OnServerEvent:Connect(function(plr, data)
	if type(data) == "table" then
		cache[plr] = data
	end
end)

Players.PlayerRemoving:Connect(function(plr)
	save(plr)
	cache[plr] = nil
end)

game:BindToClose(function()
	for _, plr in ipairs(Players:GetPlayers()) do
		save(plr)
	end
end)

task.spawn(function()
	while true do
		task.wait(90)
		for _, plr in ipairs(Players:GetPlayers()) do
			save(plr)
		end
	end
end)
]]></ProtectedString></Properties></Item></Item>
