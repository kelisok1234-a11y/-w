		desc = "+2 слота в сейфе для лучших чисел.",
		cost = function(l) return math.floor(500 * 1.8 ^ l) end,
		info = function(l) return "Слотов: " .. (6 + 2 * l) end },
}

local shop = makePanel("МАГАЗИН")

local function itemLevel(item)
	if item.key == "auto" then return data.auto and 1 or 0 end
	return data[item.key]
end

function shop.refresh()
	clearList(shop.list)
	for i, item in ipairs(SHOP) do
		local lvl = itemLevel(item)
		local r = row(shop.list, 96, i)
		simpleText(r, item.name .. "  (ур. " .. lvl .. "/" .. item.max .. ")",
			UDim2.new(0, 14, 0, 8), UDim2.new(0.62, 0, 0, 26), 20)
		simpleText(r, item.desc, UDim2.new(0, 14, 0, 34), UDim2.new(0.62, 0, 0, 40), 13,
			Color3.fromRGB(172, 172, 176), Enum.Font.Gotham)
		simpleText(r, item.info(lvl), UDim2.new(0, 14, 0, 74), UDim2.new(0.62, 0, 0, 18), 14,
			GOLD, Enum.Font.GothamBold)
		local text, color
		if lvl >= item.max then
			text, color = "МАКС", Color3.fromRGB(64, 64, 70)
		else
			local cost = item.cost(lvl)
			text = fmt(cost) .. " монет"
			color = data.coins >= cost and Color3.fromRGB(46, 190, 100) or Color3.fromRGB(190, 70, 70)
		end
		local b = button(r, text, color, {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.new(0.3, 0, 0, 46), TextScaled = false, TextSize = 17,
		})
		b.MouseButton1Click:Connect(function()
			local l = itemLevel(item)
			if l >= item.max then return end
			local cost = item.cost(l)
			if data.coins < cost then return end
			data.coins = data.coins - cost
			if item.key == "auto" then data.auto = true else data[item.key] = data[item.key] + 1 end
			data.shopBuys = data.shopBuys + 1
			dirty = true
			updateHud()
			checkAch()
			updateHud()
			shop.refresh()
			if item.key == "auto" and hooks.auto then hooks.auto() end
		end)
	end
end

