-- СПЕЦЭФФЕКТЫ
----------------------------------------------------------------
local FX = { rainbowUntil = 0, resultColor = WHITE }

local RED = Color3.fromRGB(255, 70, 90)
local YEL = Color3.fromRGB(255, 225, 70)
local GRN = Color3.fromRGB(80, 255, 130)
local CYA = Color3.fromRGB(70, 210, 255)
local PUR = Color3.fromRGB(190, 90, 255)
local RAINBOW = { RED, YEL, GRN, CYA, PUR, WHITE }

-- Звуки: впиши сюда свои rbxassetid://..., если хочешь звук. Пусто = без звука.
local SOUND_IDS = {
	roll = "", stop = "", rare = "", epic = "", legendary = "", mythic = "", secret = "",
	coin = "", jackpot = "", click = "",
}
function FX.sound(key, volume)
	local id = SOUND_IDS[key]
	if id == nil or id == "" then return end
	pcall(function()
		local s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = volume or 1
		s.Parent = gui
		s:Play()
		Debris:AddItem(s, 8)
	end)
end

local function hsv(h)
	return Color3.fromHSV(h % 1, 0.85, 1)
end

local function center()
	local v = gui.AbsoluteSize
	return v.X / 2, v.Y * 0.44
end
FX.center = center

----------------------------------------------------------------
-- частицы с физикой
----------------------------------------------------------------
local particles = {}
local MAX_PARTICLES = 380

local function addParticle(o)
	if #particles >= MAX_PARTICLES then return end
	local f
	if o.text then
		f = make("TextLabel", {
			BackgroundTransparency = 1, Text = o.text, TextColor3 = o.color, Font = Enum.Font.GothamBlack,
			TextSize = o.size, Size = UDim2.fromOffset(o.size * 1.5, o.size * 1.5),
			AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0,
		}, fx)
		f.TextStrokeColor3 = Color3.fromRGB(120, 70, 0)
		f.TextStrokeTransparency = 0.3
	else
		f = make("Frame", {
			BackgroundColor3 = o.color, BorderSizePixel = 0, Size = UDim2.fromOffset(o.size, o.size),
			AnchorPoint = Vector2.new(0.5, 0.5),
		}, fx)
		if o.round then corner(f, 0.5) end
		if o.coin then
			make("UIStroke", { Color = Color3.fromRGB(160, 105, 10), Thickness = 2 }, f)
		end
	end
	f.Position = UDim2.fromOffset(o.x, o.y)
	particles[#particles + 1] = {
		f = f, x = o.x, y = o.y, vx = o.vx, vy = o.vy, g = o.g or 0, drag = o.drag or 0,
		life = o.life, age = 0, size = o.size, rot = o.rot or 0, vr = o.vr or 0,
		flip = o.flip, isText = o.text ~= nil,
	}
end

RunService.Heartbeat:Connect(function(dt)
	local i = 1
	while i <= #particles do
		local p = particles[i]
		p.age = p.age + dt
		if p.age >= p.life then
			p.f:Destroy()
			particles[i] = particles[#particles]
			particles[#particles] = nil
		else
			p.vy = p.vy + p.g * dt
			if p.drag > 0 then
				local k = math.max(0, 1 - p.drag * dt)
				p.vx = p.vx * k
				p.vy = p.vy * k
			end
			p.x = p.x + p.vx * dt
			p.y = p.y + p.vy * dt
			p.f.Position = UDim2.fromOffset(p.x, p.y)
			p.f.Rotation = p.rot + p.vr * p.age
			local a = p.age / p.life
			local tr = 0
			if a > 0.65 then tr = (a - 0.65) / 0.35 end
			if p.isText then
				p.f.TextTransparency = tr
				p.f.TextStrokeTransparency = 0.3 + tr * 0.7
			else
				p.f.BackgroundTransparency = tr
			end
			if p.flip then
				p.f.Size = UDim2.fromOffset(math.max(3, p.size * math.abs(math.cos(p.age * p.flip))), p.size)
			end
			i = i + 1
		end
	end
end)

-- взрыв частиц. kind: dot | square | coin | seven
function FX.burst(cx, cy, n, pal, smin, smax, kind)
	for _ = 1, n do
		local a = math.random() * math.pi * 2
		local sp = smin + math.random() * (smax - smin)
		local o = {
			x = cx, y = cy, vx = math.cos(a) * sp, vy = math.sin(a) * sp - 120, g = 650, drag = 1.1,
			life = 1.0 + math.random() * 0.9, size = 9 + math.random() * 14,
			color = pal[math.random(1, #pal)], rot = math.random() * 360, vr = (math.random() - 0.5) * 700,
		}
		if kind == "dot" then
			o.round = true
		elseif kind == "coin" then
			o.round = true
			o.coin = true
			o.color = GOLD
			o.size = 18 + math.random() * 12
			o.flip = 6 + math.random() * 10
			o.life = 1.4 + math.random() * 0.8
		elseif kind == "seven" then
			o.text = "7"
			o.color = GOLD
			o.size = 26 + math.random() * 22
			o.life = 1.4 + math.random() * 0.8
		end
		addParticle(o)
	end
end

-- дождь сверху: монеты или семёрки
function FX.rain(n, dur, text)
	task.spawn(function()
		local v = gui.AbsoluteSize
		local step = math.max(1, math.floor(n / (dur * 12)))
		for i = 1, n do
			local o = {
				x = math.random() * v.X, y = -30, vx = (math.random() - 0.5) * 90, vy = 180 + math.random() * 260,
				g = 520, life = 2.6, size = 22 + math.random() * 16, color = GOLD,
				rot = math.random() * 360, vr = (math.random() - 0.5) * 400,
			}
			if text then
				o.text = text
				o.size = 30 + math.random() * 26
			else
				o.round = true
				o.coin = true
				o.flip = 5 + math.random() * 9
			end
			addParticle(o)
			if i % step == 0 then task.wait(dur / n * step) end
		end
	end)
end

----------------------------------------------------------------
-- ударные волны, лучи, молнии
----------------------------------------------------------------
function FX.ring(cx, cy, color, maxSize, dur, thick, delay)
	task.delay(delay or 0, function()
		local r = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy),
			Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, BorderSizePixel = 0,
		}, fx)
		corner(r, 0.5)
		local st = stroke(r, color, thick or 8)
		TweenService:Create(r, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(maxSize, maxSize),
		}):Play()
		TweenService:Create(st, TweenInfo.new(dur), { Transparency = 1, Thickness = 1 }):Play()
		task.delay(dur + 0.05, function() r:Destroy() end)
	end)
end

-- вращающиеся лучи света
function FX.rays(cx, cy, color, dur, speed)
	local v = gui.AbsoluteSize
	local len = math.max(v.X, v.Y) * 2.2
	local box = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, fx)
	local list = {}
	for i = 1, 8 do
		local r = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy),
			Size = UDim2.fromOffset(len, 30 + (i % 2) * 22), BackgroundColor3 = color,
			BackgroundTransparency = 0.25, BorderSizePixel = 0, Rotation = (i - 1) * 22.5,
		}, box)
		make("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.42, 0.15),
				NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(0.58, 0.15),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}, r)
		list[i] = r
	end
	local t0 = tick()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local t = tick() - t0
		if t > dur then
			conn:Disconnect()
			box:Destroy()
			return
		end
		local fade = 0.25
		if t < 0.25 then fade = 1 - (t / 0.25) * 0.75 end
		if t > dur - 0.9 then fade = 0.25 + ((t - (dur - 0.9)) / 0.9) * 0.75 end
		for i, r in ipairs(list) do
			r.Rotation = (i - 1) * 22.5 + t * (speed or 28)
			r.BackgroundTransparency = fade
		end
	end)
end

local function segment(x0, y0, x1, y1, color, thick)
	local dx, dy = x1 - x0, y1 - y0
	local len = math.sqrt(dx * dx + dy * dy)
	return make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset((x0 + x1) / 2, (y0 + y1) / 2),
		Size = UDim2.fromOffset(len + 2, thick), Rotation = math.deg(math.atan2(dy, dx)),
		BackgroundColor3 = color, BorderSizePixel = 0,
	}, fx)
end

function FX.bolt(x0, y0, x1, y1, color)
	local pts = { { x0, y0 } }
	local n = 9
	for i = 1, n - 1 do
		local t = i / n
		pts[#pts + 1] = { x0 + (x1 - x0) * t + math.random(-45, 45), y0 + (y1 - y0) * t + math.random(-30, 30) }
	end
	pts[#pts + 1] = { x1, y1 }
	local frames = {}
	for i = 1, #pts - 1 do
		local g = segment(pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2], color, 14)
		g.BackgroundTransparency = 0.55
		frames[#frames + 1] = g
	end
	for i = 1, #pts - 1 do
		frames[#frames + 1] = segment(pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2], WHITE, 4)
	end
	for _, f in ipairs(frames) do
		TweenService:Create(f, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
		Debris:AddItem(f, 0.4)
	end
end

function FX.lightning(n, color)
	local v = gui.AbsoluteSize
	local cx, cy = center()
	for i = 1, n do
		task.delay(i * 0.11, function()
			FX.bolt(math.random() * v.X, -10, cx + math.random(-160, 160), cy + math.random(-90, 90), color)
		end)
	end
end

-- глитч: цветные полосы
function FX.glitch(dur)
	task.spawn(function()
		local t0 = tick()
		local v = gui.AbsoluteSize
		while tick() - t0 < dur do
			for _ = 1, 5 do
				local f = make("Frame", {
					BorderSizePixel = 0, BackgroundColor3 = hsv(math.random()), BackgroundTransparency = 0.45,
					Position = UDim2.fromOffset(math.random(-40, 40), math.random() * v.Y),
					Size = UDim2.fromOffset(v.X, 4 + math.random() * 34),
				}, fx)
				Debris:AddItem(f, 0.07)
			end
			task.wait(0.05)
		end
	end)
end

----------------------------------------------------------------
-- вспышки, стробоскоп, тряска, аура
----------------------------------------------------------------
function FX.flash(color, strength, dur)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 1 - strength
	TweenService:Create(flash, TweenInfo.new(dur or 0.9), { BackgroundTransparency = 1 }):Play()
end

function FX.strobe(colors, count, interval, strength)
	task.spawn(function()
		for i = 1, count do
			FX.flash(colors[(i - 1) % #colors + 1], strength, interval * 0.95)
			task.wait(interval)
		end
	end)
end

function FX.tint(color, startTransparency, dur)
	tint.BackgroundColor3 = color
	tint.BackgroundTransparency = startTransparency
	TweenService:Create(tint, TweenInfo.new(dur), { BackgroundTransparency = 1 }):Play()
end

local shakeToken = 0
function FX.shake(power, dur)
	shakeToken = shakeToken + 1
	local my = shakeToken
	task.spawn(function()
		local t0 = tick()
		while tick() - t0 < dur and my == shakeToken do
			local k = 1 - (tick() - t0) / dur
			stage.Position = UDim2.fromOffset((math.random() * 2 - 1) * power * k, (math.random() * 2 - 1) * power * k)
			task.wait()
		end
		if my == shakeToken then stage.Position = UDim2.fromScale(0, 0) end
	end)
end

function FX.rainbowBoxes(dur)
	FX.rainbowUntil = tick() + dur
end

RunService.Heartbeat:Connect(function()
	if FX.rainbowUntil > 0 then
		local now = tick()
		if now > FX.rainbowUntil then
			FX.rainbowUntil = 0
			for i = 1, 6 do
				UI.boxStrokes[i].Color = FX.resultColor
				UI.digits[i].TextColor3 = FX.resultColor
			end
		else
			for i = 1, 6 do
				local c = hsv(now * 0.9 + i * 0.12)
				UI.boxStrokes[i].Color = c
				UI.digits[i].TextColor3 = c
			end
		end
	end
end)

-- "эхо" заголовка: копия текста раздувается и растворяется
function FX.echoText(text, color)
	local l = label(gui, {
		Text = text, Font = Enum.Font.GothamBlack, TextColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.17),
		Size = UDim2.fromScale(0.9, 0.1), ZIndex = 41,
	})
	TweenService:Create(l, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.fromScale(1.7, 0.34), TextTransparency = 1,
	}):Play()
	Debris:AddItem(l, 1)
end

-- пульс рамок цифр
function FX.pulseBoxes(thickness)
	for i = 1, 6 do
		UI.boxStrokes[i].Thickness = thickness
		TweenService:Create(UI.boxStrokes[i], TweenInfo.new(0.7, Enum.EasingStyle.Quad), { Thickness = 3 }):Play()
	end
end

----------------------------------------------------------------
-- ГЛАВНЫЕ ПАКЕТЫ ЭФФЕКТОВ ПО РЕДКОСТИ
----------------------------------------------------------------
function FX.play(tier)
	local t = TIERS[tier]
	local cx, cy = center()
	local c = t.color
	local pal = { c, WHITE, c:Lerp(WHITE, 0.5), GOLD }
	FX.sound(({ "", "", "rare", "epic", "legendary", "mythic", "secret" })[tier], 1)

	if tier == 1 then
		-- ОБЫЧНОЕ: почти без эффектов, лёгкий отклик
		FX.burst(cx, cy, 4, { c }, 90, 200, "dot")
	elseif tier == 2 then
		-- НЕОБЫЧНОЕ: небольшая вспышка и пара частиц
		FX.flash(c, 0.08, 0.35)
		FX.ring(cx, cy, c, 300, 0.5, 4)
		FX.burst(cx, cy, 10, { c, c:Lerp(WHITE, 0.5) }, 110, 260, "square")
	elseif tier == 3 then
		FX.flash(c, 0.15, 0.5)
		FX.ring(cx, cy, c, 520, 0.7, 6)
		FX.burst(cx, cy, 26, pal, 160, 380, "square")
		FX.shake(3, 0.25)
	elseif tier == 4 then
		FX.flash(c, 0.3, 0.7)
		FX.ring(cx, cy, c, 760, 0.8, 8)
		FX.ring(cx, cy, WHITE, 520, 0.6, 5, 0.1)
		FX.burst(cx, cy, 50, pal, 200, 520, "square")
		FX.burst(cx, cy, 16, pal, 220, 560, "coin")
		FX.rain(20, 1.2)
		FX.shake(7, 0.45)
		FX.tint(c, 0.7, 1.3)
		FX.pulseBoxes(8)
	elseif tier == 5 then
		FX.strobe({ c, WHITE, c }, 3, 0.09, 0.45)
		FX.rays(cx, cy, c, 3.4)
		for i = 0, 3 do FX.ring(cx, cy, (i % 2 == 0) and c or WHITE, 1000, 0.95, 10, i * 0.12) end
		FX.burst(cx, cy, 90, pal, 260, 720, "square")
		FX.burst(cx, cy, 34, pal, 300, 800, "coin")
		FX.rain(50, 2.2)
		FX.shake(12, 0.85)
		FX.tint(c, 0.55, 2.2)
		FX.echoText(t.name .. "!", c)
		FX.pulseBoxes(11)
	elseif tier == 6 then
		FX.strobe({ c, WHITE, GOLD, WHITE }, 7, 0.08, 0.6)
		FX.rays(cx, cy, c, 4.6, 40)
		FX.rays(cx, cy, WHITE, 3.4, -55)
		for i = 0, 5 do FX.ring(cx, cy, (i % 2 == 0) and c or GOLD, 1200, 1.0, 12, i * 0.1) end
		FX.lightning(6, c)
		FX.burst(cx, cy, 140, RAINBOW, 300, 900, "square")
		FX.burst(cx, cy, 50, pal, 350, 950, "coin")
		FX.rain(90, 3.2)
		FX.shake(18, 1.3)
		FX.tint(c, 0.4, 3)
		FX.rainbowBoxes(4)
		FX.echoText(t.name .. "!!", WHITE)
		task.delay(0.5, function() FX.echoText(t.name .. "!!", c) end)
		FX.pulseBoxes(14)
	elseif tier == 7 then
		-- СЕКРЕТНОЕ: всё и сразу
		FX.glitch(0.9)
		FX.strobe(RAINBOW, 14, 0.07, 0.7)
		FX.rays(cx, cy, WHITE, 6, 50)
		FX.rays(cx, cy, GOLD, 5, -70)
		FX.rays(cx, cy, c:Lerp(PUR, 0.5), 4.5, 90)
		for i = 0, 9 do FX.ring(cx, cy, hsv(i * 0.1), 1500, 1.2, 14, i * 0.09) end
		FX.lightning(12, WHITE)
		task.delay(1.0, function() FX.lightning(8, GOLD) end)
		FX.burst(cx, cy, 220, RAINBOW, 350, 1100, "square")
		FX.burst(cx, cy, 70, pal, 400, 1100, "coin")
		FX.burst(cx, cy, 30, pal, 300, 800, "seven")
		FX.rain(160, 5)
		FX.shake(26, 2.2)
		FX.tint(WHITE, 0.2, 3.5)
		FX.rainbowBoxes(9)
		FX.echoText(t.name .. "!!!", WHITE)
		task.delay(0.4, function() FX.echoText(t.name .. "!!!", GOLD) end)
		task.delay(0.8, function() FX.echoText(t.name .. "!!!", c) end)
		FX.pulseBoxes(18)
		-- конфетти-салюты ещё несколько секунд
		task.spawn(function()
			local v = gui.AbsoluteSize
			for _ = 1, 8 do
				task.wait(0.5)
				local sx, sy = math.random() * v.X, math.random() * v.Y * 0.6 + 40
				FX.ring(sx, sy, hsv(math.random()), 420, 0.7, 8)
				FX.burst(sx, sy, 24, RAINBOW, 200, 520, "dot")
			end
		end)
	end
end

-- бонусы семёрок: чем больше семёрок, тем сильнее
function FX.sevens(count)
	local cx, cy = center()
	if count >= 4 then
		FX.burst(cx, cy, 40, { GOLD }, 300, 800, "seven")
		FX.rain(60, 2.4, "7")
		FX.strobe({ GOLD, WHITE }, 4, 0.09, 0.45)
		FX.rays(cx, cy, GOLD, 3)
		FX.shake(12, 0.8)
	elseif count == 3 then
		FX.burst(cx, cy, 26, { GOLD }, 260, 700, "seven")
		FX.rain(30, 1.8, "7")
		FX.flash(GOLD, 0.35, 0.8)
		FX.ring(cx, cy, GOLD, 800, 0.8, 10)
		FX.shake(8, 0.6)
	elseif count == 2 then
		FX.burst(cx, cy, 12, { GOLD }, 200, 520, "seven")
		FX.ring(cx, cy, GOLD, 500, 0.6, 6)
	else
		FX.burst(cx, cy, 4, { GOLD }, 150, 360, "seven")
	end
end

-- ДЖЕКПОТ слота
function FX.jackpot()
	local cx, cy = center()
	FX.sound("jackpot", 1)
	FX.strobe({ GOLD, WHITE, RED, GOLD }, 10, 0.08, 0.6)
	FX.rays(cx, cy, GOLD, 5, 45)
	FX.rays(cx, cy, WHITE, 4, -60)
	for i = 0, 5 do FX.ring(cx, cy, (i % 2 == 0) and GOLD or WHITE, 1300, 1.0, 12, i * 0.1) end
	FX.burst(cx, cy, 60, { GOLD }, 350, 1000, "seven")
	FX.burst(cx, cy, 80, { GOLD, WHITE }, 350, 1000, "coin")
	FX.rain(130, 4, nil)
	task.delay(0.6, function() FX.rain(60, 3, "7") end)
	FX.lightning(6, GOLD)
	FX.shake(20, 1.8)
	FX.tint(GOLD, 0.35, 3)
end

